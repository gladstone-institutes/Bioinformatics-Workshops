// ============================================================================
// Nextflow config template for UCSF CoreHPC (SLURM).
// Project-agnostic: no hardcoded project paths. Copy it, do not edit it.
//
// Set these in your launcher before `nextflow run`:
//   export COREHPC_PROJECT=/mnt/gladstone/bioinformatics/projects/<your-project>
//   export APPTAINER_BINDPATH="/mnt/scratch,$COREHPC_PROJECT"
//   export NXF_SINGULARITY_CACHEDIR="$COREHPC_PROJECT/singularity-cache"
//   export NXF_OFFLINE=true      # compute nodes have no internet
//
// Optional overrides: COREHPC_ACCOUNT, COREHPC_PARTITION, COREHPC_SCRATCH,
// COREHPC_WORKDIR, COREHPC_CACHEDIR, COREHPC_REPORTS.
//
// Then: nextflow run <local pipeline copy> -profile singularity -c this.config -resume
// See docs/running_nextflow_on_corehpc.md for the full setup.
// ============================================================================

// --- Resolve paths from the environment -------------------------------------
def projRoot = System.getenv('COREHPC_PROJECT')
if( !projRoot )
    throw new IllegalStateException(
        "COREHPC_PROJECT is not set. Export it to your project root on CoreHPC " +
        "(note the /mnt prefix: /mnt/gladstone/bioinformatics/projects/<project>).")

def scratch    = System.getenv('COREHPC_SCRATCH')   ?: '/mnt/scratch'
def account    = System.getenv('COREHPC_ACCOUNT')   ?: 'hpc_core'
def partition  = System.getenv('COREHPC_PARTITION') ?: 'cpu'
def workPath   = System.getenv('COREHPC_WORKDIR')   ?: "${projRoot}/work"
def cachePath  = System.getenv('COREHPC_CACHEDIR')  ?: "${projRoot}/singularity-cache"
def reportPath = System.getenv('COREHPC_REPORTS')   ?: 'reports'

workDir = workPath

// --- Scheduler --------------------------------------------------------------
process {
    executor       = 'slurm'
    queue          = partition
    clusterOptions = "--account=${account}"

    // Ceiling for every process. Recent nf-core removed --max_cpus/--max_memory/
    // --max_time; anything requested above these is clamped down instead.
    // Raise to match what your partition actually offers.
    resourceLimits = [ cpus: 4, memory: 60.GB, time: 50.h ]

    // nf-core defaults the shell to include -C (noclobber). On -resume a task
    // reruns in its old work dir where its output still exists, and -C makes the
    // '>' redirect fail with "cannot overwrite existing file". Drop -C only.
    shell = ['bash', '-e', '-u', '-o', 'pipefail']

    // Conservative defaults. Override per process at the bottom.
    cpus   = 2
    memory = { 8.GB * task.attempt }
    time   = { 4.h * task.attempt }

    // Retry on OOM and node/scheduler kills, fail fast on real errors.
    // 137 = OOM, 140 = walltime, 143 = SIGTERM from the scheduler.
    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2
}

// --- Containers -------------------------------------------------------------
// Compute nodes cannot pull images, so cacheDir must already hold them. Populate
// it on the login node with `nf-core pipelines download
// --container-cache-utilisation amend` and NXF_SINGULARITY_CACHEDIR set to the
// same path. If only `apptainer` is on PATH, run with -profile apptainer.
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = cachePath
    // Containers cannot see unbound paths; a missing bind reads as a missing
    // input file. Bind scratch and the project root.
    runOptions = "--bind ${scratch} --bind ${projRoot}"
}

// --- Executor throttling ----------------------------------------------------
executor {
    queueSize       = 20        // max concurrent child jobs; raise if the queue allows
    submitRateLimit = '10 sec'  // avoid hammering the scheduler at startup
    exitReadTimeout = '15 min'  // shared filesystems are slow to show exit files
}

// --- Reports ----------------------------------------------------------------
// overwrite=true, otherwise a -resume relaunch aborts with "Trace file already
// exists". Each relaunch replaces the previous files, so copy them aside to keep
// them. These land relative to the launch dir, not --outdir.
report   { enabled = true; overwrite = true; file = "${reportPath}/execution_report.html" }
timeline { enabled = true; overwrite = true; file = "${reportPath}/execution_timeline.html" }
trace    { enabled = true; overwrite = true; file = "${reportPath}/execution_trace.txt" }

// ============================================================================
// Per-process overrides. Delete these and add your own; they are examples from
// an nf-core/rnaseq run, not defaults worth keeping.
//
// process {
//     withName: 'STAR_GENOMEGENERATE' { cpus = 4; memory = '60.GB'; time = '8.h' }
//     withName: 'STAR_ALIGN'          { cpus = 4; memory = '40.GB'; time = '8.h' }
//
//     // Memory-heavy step. Scale on retry rather than requesting the peak up
//     // front, so the first attempt stays schedulable.
//     withName: 'SALMON_QUANT'        { memory = { 24.GB * task.attempt } }
//
//     // Skip a non-essential QC step that fails on upstream data problems.
//     withName: 'FQ_LINT'             { errorStrategy = 'ignore' }
// }
// ============================================================================
